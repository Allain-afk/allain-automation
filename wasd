local function collectAllEggParts()
	local list = {}
	local build = workspace:FindFirstChild("Build")
	local zoneBuilds = build and build:FindFirstChild("ZoneBuilds")
	if zoneBuilds then
		for _, zoneFolder in ipairs(zoneBuilds:GetChildren()) do
			local eggsFolder = zoneFolder:FindFirstChild("Eggs")
			if eggsFolder then
				for _, eggContainer in ipairs(eggsFolder:GetChildren()) do
					local eggPart = eggContainer:FindFirstChild("Egg")
					if eggPart and eggPart:IsA("BasePart") then
						table.insert(list, eggPart)
					elseif eggContainer:IsA("BasePart") and eggContainer:GetAttribute("EggInfoName") then
						table.insert(list, eggContainer)
					end
				end
			end
		end
	end
	local topEggs = workspace:FindFirstChild("Eggs")
	if topEggs then
		for _, child in ipairs(topEggs:GetChildren()) do
			local eggPart = child:IsA("BasePart") and child or child:FindFirstChild("Egg")
			if eggPart and eggPart:IsA("BasePart") then
				table.insert(list, eggPart)
			end
		end
	end
	return list
end

updateAllEggEsp = function()
	if not eggEspEnabled or Library.Unloaded then
		for _, entry in pairs(eggEspObjects) do
			if entry.Highlight then
				entry.Highlight.Enabled = false
			end
			if entry.Billboard then
				entry.Billboard.Enabled = false
			end
		end
		return
	end

	local eggParts = collectAllEggParts()
	local validSet = {}
	for _, ep in ipairs(eggParts) do
		validSet[ep] = true
	end
	for ep in pairs(eggEspObjects) do
		if not ep.Parent or not validSet[ep] then
			removeEggEsp(ep)
		end
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, eggPart in ipairs(eggParts) do
		local isBroken = eggPart:GetAttribute("Broken") == true
		local hp = tonumber(eggPart:GetAttribute("Health"))
		if not isBroken and (not hp or hp > 0) then
			local dist = myRoot and (eggPart.Position - myRoot.Position).Magnitude or 0
			local eggName = eggPart:GetAttribute("EggInfoName") or eggPart:GetAttribute("EggType") or "Egg"
			local eggRarity = tostring(eggPart:GetAttribute("EggInfoRarity") or "")
			local luckAttr = tostring(eggPart:GetAttribute("EggInfoLuck") or "")
			local weightKg = tonumber(eggPart:GetAttribute("WeightKg"))
			local mutationStr = nil

			local overhead = eggPart:FindFirstChild("EggOverhead")
			local infoUi = overhead and overhead:FindFirstChild("EggInfoUi")
			if infoUi then
				if luckAttr == "" then
					local luckLbl = infoUi:FindFirstChild("LuckMulti")
					if luckLbl and luckLbl:IsA("TextLabel") then
						luckAttr = luckLbl.Text
					end
				end
				if eggRarity == "" then
					local rarLbl = infoUi:FindFirstChild("Rarity")
					if rarLbl and rarLbl:IsA("TextLabel") then
						eggRarity = rarLbl.Text
					end
				end
				local mutLbl = infoUi:FindFirstChild("Mutation")
				if mutLbl and mutLbl:IsA("TextLabel") and mutLbl.Visible and mutLbl.Text ~= "" then
					mutationStr = mutLbl.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
				end
			end

			local luckNum = tonumber(luckAttr:match("([%d%.]+)")) or 0
			local rarityAllowed = (eggRarity == "") or isRaritySelectedInTable(eggRarity, eggRaritySelected)

			if dist <= espMaxDistance and luckNum >= eggMinLuck and rarityAllowed then
				local entry = createOrGetEggEsp(eggPart)
				local color = getEggDisplayColor(eggRarity)

				entry.Highlight.Adornee = eggPart
				entry.Highlight.FillColor = color
				entry.Highlight.OutlineColor = color
				entry.Highlight.FillTransparency = espFillTrans
				entry.Highlight.OutlineTransparency = espOutlineTrans
				entry.Highlight.Enabled = true

				local titleText = tostring(eggName)
				if mutationStr and mutationStr ~= "" then
					titleText = string.format("%s [%s]", titleText, mutationStr)
				end
				if eggRarity ~= "" then
					titleText = string.format("%s (%s)", titleText, eggRarity)
				end
				titleText = string.format("%s [%dm]", titleText, math.floor(dist + 0.5))

				local subParts = {}
				if luckNum > 0 then
					table.insert(subParts, string.format("🍀 x%.1f Luck", luckNum):gsub("%.0 Luck", " Luck"))
				elseif luckAttr ~= "" then
					table.insert(subParts, luckAttr)
				end
				if hp then
					table.insert(subParts, formatAbbreviatedNumber(hp) .. " HP")
				end
				if weightKg then
					table.insert(subParts, string.format("%.1f KG", weightKg):gsub("%.0 KG", " KG"))
				end

				entry.Billboard.Adornee = eggPart
				entry.Label.TextColor3 = color
				entry.Label.TextSize = espTextSize
				entry.Label.Text = titleText .. (#subParts > 0 and ("\n" .. table.concat(subParts, " · ")) or "")
				entry.Billboard.Enabled = true
			else
				local entry = eggEspObjects[eggPart]
				if entry then
					entry.Highlight.Enabled = false
					entry.Billboard.Enabled = false
				end
			end
		else
			local entry = eggEspObjects[eggPart]
			if entry then
				entry.Highlight.Enabled = false
				entry.Billboard.Enabled = false
			end
		end
	end
end

