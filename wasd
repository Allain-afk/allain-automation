local function getQueueOnTeleport()
	return queue_on_teleport
		or (syn and syn.queue_on_teleport)
		or (fluxus and fluxus.queue_on_teleport)
		or queueonteleport
end

local function queueScriptForTeleport()
	if hasQueuedTeleport or not autoReconnectEnabled or Library.Unloaded then
		return
	end
	local queueFunc = getQueueOnTeleport()
	if queueFunc then
		local ok = pcall(function()
			queueFunc(string.format([[
if not game:IsLoaded() then
	game.Loaded:Wait()
end
shared.__AllainReconnected = true
loadstring(game:HttpGet(%q))()
]], scriptUrl))
		end)
		if ok then
			hasQueuedTeleport = true
		end
	end
end

local teleportConnection = player.OnTeleport:Connect(function()
	if autoReconnectEnabled and not Library.Unloaded then
		queueScriptForTeleport()
	end
end)

local function triggerReconnect(reason)
	if isReconnecting or not autoReconnectEnabled or Library.Unloaded then
		return
	end
	isReconnecting = true
	StatusLabel:SetText("Status: Disconnected — Reconnecting...")
	Window:SetBadge("Reconnecting")

	if webhookNotifyEvents then
		task.spawn(function()
			sendEventWebhook(
				"Disconnected — " .. tostring(player.Name),
				string.format("Reason: `%s` — Attempting auto-reconnect...", tostring(reason or "Unknown")),
				0xED4245
			)
		end)
	end

	queueScriptForTeleport()

	task.spawn(function()
		local attempt = 0
		while autoReconnectEnabled and not Library.Unloaded do
			attempt += 1
			task.wait(attempt == 1 and 2 or 5)
			if Library.Unloaded or not autoReconnectEnabled then
				break
			end

			queueScriptForTeleport()

			if attempt <= 2 and game.JobId and game.JobId ~= "" then
				pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				end)
			else
				pcall(function()
					TeleportService:Teleport(game.PlaceId, player)
				end)
			end
		end
		isReconnecting = false
	end)
end

local errorChangedConnection = GuiService.ErrorMessageChanged:Connect(function(errorMessage)
	if errorMessage and errorMessage ~= "" then
		triggerReconnect(errorMessage)
