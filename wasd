local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = pcall(function()
	return game:GetService("VirtualInputManager")
end) and game:GetService("VirtualInputManager") or nil

local player = Players.LocalPlayer
if not player then
	warn("[AutoWASD] This script must run as a LocalScript on the client, not a server Script!")
	return
end

--// Load Alexandria Library \\--
local repo = "https://raw.githubusercontent.com/Allain-afk/allain-automation/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()

local Toggles = Library.Toggles
local Options = Library.Options

--// State Variables \\--
local isRunning = false
local antiAfkEnabled = true
local walkDistance = 4
local pauseDuration = 4

--// Window & Tabs \\--
