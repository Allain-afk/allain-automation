local function sendWorkspacePetSnapshot()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myPos = myRoot and myRoot.Position

	local lines = {}

	local function inspectFolder(folderName, maxItems)
		local folder = workspace:FindFirstChild(folderName)
		if not folder then
			table.insert(lines, string.format("-- %s: NOT FOUND --", folderName))
			return
		end
		local children = folder:GetChildren()
		table.insert(lines, string.format("=== %s (%d children) ===", folderName, #children))

		-- Sort by distance to player so the closest hatched pet is first!
		table.sort(children, function(a, b)
			local posA, posB
			pcall(function()
				posA = a:IsA("Model") and a:GetPivot().Position or (a:IsA("BasePart") and a.Position or nil)
			end)
			pcall(function()
				posB = b:IsA("Model") and b:GetPivot().Position or (b:IsA("BasePart") and b.Position or nil)
			end)
			local dA = (myPos and posA) and (posA - myPos).Magnitude or 999999
			local dB = (myPos and posB) and (posB - myPos).Magnitude or 999999
			return dA < dB
		end)

		for i = 1, math.min(#children, maxItems) do
			local item = children[i]
			local pos = nil
			pcall(function()
				pos = item:IsA("Model") and item:GetPivot().Position or (item:IsA("BasePart") and item.Position or nil)
			end)
			local dist = (myPos and pos) and math.floor((pos - myPos).Magnitude) or -1
			table.insert(lines, string.format("\n[%d] %s (%s) [Dist: %dm]", i, item.Name, item.ClassName, dist))

			-- Item Attributes
			local attrs = item:GetAttributes()
			if next(attrs) ~= nil then
				local kv = {}
				for k, v in pairs(attrs) do
					table.insert(kv, string.format("%s=%s", tostring(k), tostring(v)))
				end
				table.sort(kv)
				table.insert(lines, "  Attrs: {" .. table.concat(kv, ", ") .. "}")
			end

			-- Descendant Attributes, TextLabels, ProximityPrompts, and ValueBases
			for _, desc in ipairs(item:GetDescendants()) do
				local dAttrs = desc:GetAttributes()
				if next(dAttrs) ~= nil then
					local kv = {}
					for k, v in pairs(dAttrs) do
						table.insert(kv, string.format("%s=%s", tostring(k), tostring(v)))
					end
					table.sort(kv)
					local relPath = desc:GetFullName():gsub("^Workspace%." .. folderName .. "%.", "")
					table.insert(lines, string.format("  [SubAttr] %s (%s) -> {%s}", relPath, desc.ClassName, table.concat(kv, ", ")))
				end

				if desc:IsA("TextLabel") or desc:IsA("TextButton") then
					local t = (desc.Text or ""):gsub("<[^>]+>", ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
					if t ~= "" then
						local relPath = desc:GetFullName():gsub("^Workspace%." .. folderName .. "%.", "")
						table.insert(lines, string.format("  [Text] %s = %q", relPath, t))
					end
				elseif desc:IsA("ProximityPrompt") then
					table.insert(lines, string.format("  [Prompt] %s: Action=%q Object=%q", desc.Name, tostring(desc.ActionText), tostring(desc.ObjectText)))
				elseif desc:IsA("ValueBase") then
					table.insert(lines, string.format("  [Val] %s = %s", desc.Name, tostring(desc.Value)))
				end
			end
		end
	end

	inspectFolder("AnimalPickups", 5)
	inspectFolder("CarriedAnimals", 3)

	-- Also check PromptAnchors near player in case prompts live in workspace.PromptAnchor
	local promptLines = {}
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == "PromptAnchor" and child:IsA("BasePart") then
			local dist = myPos and math.floor((child.Position - myPos).Magnitude) or 9999
			if dist <= 120 then
				local attrs = child:GetAttributes()
				local kv = {}
				for k, v in pairs(attrs) do
					table.insert(kv, string.format("%s=%s", tostring(k), tostring(v)))
				end
				for _, sub in ipairs(child:GetDescendants()) do
					if sub:IsA("ProximityPrompt") then
						table.insert(kv, string.format("Prompt(%q, %q)", tostring(sub.ActionText), tostring(sub.ObjectText)))
					end
					for k, v in pairs(sub:GetAttributes()) do
						table.insert(kv, string.format("%s.%s=%s", sub.Name, tostring(k), tostring(v)))
					end
				end
				table.insert(promptLines, string.format("[PromptAnchor %dm] {%s}", dist, table.concat(kv, ", ")))
			end
		end
	end
	if #promptLines > 0 then
		table.insert(lines, "\n=== Nearby PromptAnchors ===")
		for _, pl in ipairs(promptLines) do
			table.insert(lines, pl)
		end
	end

	local body = table.concat(lines, "\n")
	if #body > 3800 then
		body = body:sub(1, 3800) .. "\n... (truncated)"
	end

	local ok1, err1 = postDiscordEmbed({
		title = "AnimalPickups Inspector (v2.2)",
		description = "```text\n" .. body .. "\n```",
		color = 0xFEE75C,
	})

	if ok1 then
		Library:Notify("AnimalPickups Snapshot sent to Discord!", 3)
	else
		Library:Notify("Snapshot failed: " .. tostring(err1), 4)
	end
end

