local function autoSaveActiveConfig()
	if isInitializingConfig or not autoSaveEnabled then
		return
	end
	local targetConfig = SaveManager.AutoloadConfig
	if not targetConfig or targetConfig == "none" or targetConfig == "" then
		targetConfig = "default"
	end
	local saved = SaveManager:Save(targetConfig)
	if saved and (not SaveManager.AutoloadConfig or SaveManager.AutoloadConfig == "none") then
		SaveManager:SaveAutoloadConfig(targetConfig)
	end
end

