			for _, child in ipairs(zoneFolder:GetChildren()) do
				if child:IsA("Model") and child.Name ~= "Eggs" then
					if child:GetAttribute("ChaseState") ~= nil or child:GetAttribute("RigMode") ~= nil or child:FindFirstChild("BodyHitbox") then
						table.insert(guards, child)
					end
				end
			end
		end
	end
	return guards
end

local function updateAllGuardEsp()
	if (not guardEspEnabled and not guardWarnEnabled) or Library.Unloaded then
		for _, entry in pairs(guardEspObjects) do
			if entry.Highlight then
				entry.Highlight.Enabled = false
			end
			if entry.Billboard then
				entry.Billboard.Enabled = false
			end
		end
		return
	end

	local guards = collectAllGuardModels()
	local validSet = {}
	for _, g in ipairs(guards) do
		validSet[g] = true
	end
	for g in pairs(guardEspObjects) do
		if not g.Parent or not validSet[g] then
			removeGuardEsp(g)
		end
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local now = os.clock()

	for _, guardModel in ipairs(guards) do
		local rootPart = guardModel:FindFirstChild("Main")
			or guardModel:FindFirstChild("HumanoidRootPart")
			or guardModel:FindFirstChild("BodyHitbox")
			or guardModel.PrimaryPart
			or guardModel:FindFirstChildWhichIsA("BasePart")

		if rootPart and rootPart:IsA("BasePart") then
			local dist = myRoot and (rootPart.Position - myRoot.Position).Magnitude or 9999
			local chaseState = tostring(guardModel:GetAttribute("ChaseState") or "Roaming")
			local zoneId = tostring(guardModel:GetAttribute("ZoneId") or (guardModel.Parent and guardModel.Parent.Name) or "")
			local isChasing = chaseState:lower() ~= "roaming" and chaseState:lower() ~= "idle"
			local isDangerClose = dist <= guardWarnDistance or (isChasing and dist <= (guardWarnDistance * 1.6))

			-- Proximity Warning
			if guardWarnEnabled and isDangerClose then
				local lastWarn = guardLastWarnTime[guardModel] or 0
				if (now - lastWarn) >= 8 then
					guardLastWarnTime[guardModel] = now
					local cleanGuardName = formatPetModelName(guardModel.Name)
					Library:Notify(
						string.format("⚠ Guard Alert: %s is %dm away (%s)!", cleanGuardName, math.floor(dist + 0.5), chaseState),
						4
					)
					playClientAlertSound("rbxassetid://4590662766", 1.4, 1.05)
				end
			end

			-- Visual Guard ESP
			if guardEspEnabled and dist <= espMaxDistance then
				local entry = createOrGetGuardEsp(guardModel)
				local color = (isChasing or isDangerClose) and Color3.fromRGB(255, 65, 65) or Color3.fromRGB(255, 180, 55)

				entry.Highlight.Adornee = guardModel
				entry.Highlight.FillColor = color
				entry.Highlight.OutlineColor = color
				entry.Highlight.FillTransparency = espFillTrans
				entry.Highlight.OutlineTransparency = espOutlineTrans
				entry.Highlight.Enabled = true

				local cleanGuardName = formatPetModelName(guardModel.Name)
				local line1 = string.format("⚠ %s%s [%dm]", cleanGuardName, zoneId ~= "" and (" (" .. zoneId .. ")") or "", math.floor(dist + 0.5))
				local line2 = string.format("State: %s", chaseState)

				entry.Billboard.Adornee = rootPart
				entry.Label.TextColor3 = color
				entry.Label.TextSize = espTextSize
				entry.Label.Text = line1 .. "\n" .. line2
				entry.Billboard.Enabled = true
			else
				local entry = guardEspObjects[guardModel]
				if entry then
					entry.Highlight.Enabled = false
					entry.Billboard.Enabled = false
				end
			end
		end
	end
end

--// 3. Live Top-Pets Radar & Rare Pet Spawn Alert \\--
local function scanGroundPetsAndAlerts()
	local pickupsFolder = workspace:FindFirstChild("AnimalPickups")
	if not pickupsFolder then
		TopPet1Label:SetText("#1: None on ground")
		TopPet2Label:SetText("#2: --")
		TopPet3Label:SetText("#3: --")
		BestGroundPetLabel:SetText("Best Ground Pet: None")
		return
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	local groundPets = {}

	for _, petModel in ipairs(pickupsFolder:GetChildren()) do
		if petModel:IsA("Model") or petModel:IsA("BasePart") then
			local rootPart = petModel:IsA("Model")
				and (petModel:FindFirstChild("RootPart") or petModel.PrimaryPart or petModel:FindFirstChildWhichIsA("BasePart"))
				or petModel

			if rootPart and rootPart:IsA("BasePart") then
				if not petFirstSeenAt[petModel] then
					petFirstSeenAt[petModel] = now
				end

				local dist = myRoot and (rootPart.Position - myRoot.Position).Magnitude or 0
				local rawName = tostring(petModel:GetAttribute("AnimalName") or petModel.Name)
				local cleanName = formatPetModelName(rawName)
				local rarityAttr = petModel:GetAttribute("Rarity")
				local weightKg = tonumber(petModel:GetAttribute("WeightKg"))
				local weightBracket = tostring(petModel:GetAttribute("WeightBracket") or "")
				local hatchId = petModel:GetAttribute("HatchId")

				local cpsText, timerText, rarityGuiText, mutationText = extractPetOverheadInfo(petModel, rootPart)
				local finalRarity = (rarityAttr and tostring(rarityAttr) ~= "" and tostring(rarityAttr)) or rarityGuiText or "Unknown"

				local cpsNum = 0
				if cpsText and cpsText ~= "" then
					cpsNum = parseAbbreviatedNumber(cpsText:gsub("/s", "")) or 0
				end

				local rank = rarityRank[finalRarity:lower()] or 0

				local wStr = weightKg and (string.format("%.1f KG", weightKg):gsub("%.0 KG", " KG")) or nil
				if wStr and weightBracket ~= "" then
					wStr = wStr .. " [" .. weightBracket .. "]"
				end

				table.insert(groundPets, {
					model = petModel,
					name = cleanName,
					mutation = mutationText,
					rarity = finalRarity,
					rarityRank = rank,
					cpsText = cpsText or "$0/s",
					cpsNum = cpsNum,
					weightStr = wStr,
					timerText = timerText,
					dist = math.floor(dist + 0.5),
					hatchId = hatchId,
				})

				-- Check Rare Pet Spawn Alert (wait up to 0.3s if overhead Cash/s text is still loading)
				local petKey = hatchId and ("id_" .. tostring(hatchId)) or petModel
				local overheadReady = (cpsText ~= nil and cpsText ~= "") or ((now - petFirstSeenAt[petModel]) >= 0.35)
				if overheadReady and not alertedPetKeys[petKey] then
					alertedPetKeys[petKey] = true

					if rarePetAlertEnabled and isRaritySelectedInTable(finalRarity, rarePetAlertSelected) then
						local minCashRequired = (rarePetMinCashM or 0) * 1e6
						if minCashRequired <= 0 or cpsNum >= minCashRequired then
							local mutTag = (mutationText and mutationText ~= "") and (" [" .. mutationText .. "]") or ""
							local alertSummary = string.format(
								"🌟 Rare Pet: %s%s (%s) — %s%s [%dm]",
								cleanName,
								mutTag,
								finalRarity,
								cpsText or "N/A",
								wStr and (" · " .. wStr) or "",
								math.floor(dist + 0.5)
							)
							Library:Notify(alertSummary, 6)

							if rarePetSoundEnabled then
								playClientAlertSound("rbxassetid://4590657391", 1.8, 1)
							end

							if rarePetWebhookEnabled then
								local embedColor = rarityHexColors[finalRarity:lower()] or 0x57F287
								task.spawn(function()
									postDiscordEmbed({
										title = string.format("🌟 Rare Pet Spawned — %s (%s)", cleanName, finalRarity),
										description = string.format("Spotted on server for **%s**", tostring(player.Name)),
										color = embedColor,
										fields = {
											{ name = "Pet", value = cleanName .. mutTag, inline = true },
											{ name = "Rarity", value = finalRarity, inline = true },
											{ name = "Cash/s", value = cpsText or "N/A", inline = true },
											{ name = "Weight", value = wStr or "N/A", inline = true },
											{ name = "Despawn Timer", value = timerText or "N/A", inline = true },
											{ name = "Distance", value = string.format("%dm away", math.floor(dist + 0.5)), inline = true },
										},
									})
								end)
							end
						end
					end
				end
			end
		end
	end

	table.sort(groundPets, function(a, b)
		if a.cpsNum ~= b.cpsNum then
			return a.cpsNum > b.cpsNum
		end
		if a.rarityRank ~= b.rarityRank then
			return a.rarityRank > b.rarityRank
		end
		return a.dist < b.dist
	end)

	local function formatRadarEntry(idx, p)
		if not p then
			return string.format("#%d: --", idx)
		end
		local mut = (p.mutation and p.mutation ~= "") and (" [" .. p.mutation .. "]") or ""
		local tmr = (p.timerText and p.timerText ~= "") and (" · ⏱" .. p.timerText) or ""
		return string.format("#%d: %s%s (%s) — %s%s [%dm]", idx, p.name, mut, p.rarity, p.cpsText, tmr, p.dist)
	end

	if #groundPets == 0 then
		TopPet1Label:SetText("#1: No hatched pets on ground")
		TopPet2Label:SetText("#2: --")
		TopPet3Label:SetText("#3: --")
		BestGroundPetLabel:SetText("Best Ground Pet: None")
	else
		TopPet1Label:SetText(formatRadarEntry(1, groundPets[1]))
		TopPet2Label:SetText(formatRadarEntry(2, groundPets[2]))
		TopPet3Label:SetText(formatRadarEntry(3, groundPets[3]))
		local best = groundPets[1]
		BestGroundPetLabel:SetText(string.format("Best Pet: %s (%s) %s [%dm]", best.name, best.rarity, best.cpsText, best.dist))
	end
end

task.spawn(function()
	while not Library.Unloaded do
		local anyVisualActive = espEnabled or petEspEnabled or eggEspEnabled or guardEspEnabled or guardWarnEnabled
		if anyVisualActive then
			if espEnabled then
				pcall(updateAllEsp)
			end
			if petEspEnabled then
				pcall(updateAllPetEsp)
			end
			if eggEspEnabled then
				pcall(updateAllEggEsp)
			end
			if guardEspEnabled or guardWarnEnabled then
				pcall(updateAllGuardEsp)
			end
			task.wait(0.15)
		else
			task.wait(0.3)
		end
	end
end)

task.spawn(function()
	local lastHeartbeat = os.clock()
	local lastStatSample = 0
	while not Library.Unloaded do
		local now = os.clock()
		UptimeLabel:SetText("Uptime: " .. formatDuration(now - sessionStartTime))
		pcall(scanGroundPetsAndAlerts)

		local pingMs = 0
		pcall(function()
			pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		PerfLabel:SetText(string.format("Performance: %d FPS | %d ms", currentFps, pingMs))

		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart and anchorPosition then
			local drift = Vector3.new(
				rootPart.Position.X - anchorPosition.X,
				0,
				rootPart.Position.Z - anchorPosition.Z
			).Magnitude
			DriftLabel:SetText(string.format("Anchor Drift: %.1f studs", drift))
		else
			DriftLabel:SetText("Anchor Drift: 0.0 studs")
		end

		-- Sample cash every 5s to keep the per-second rate and session gain accurate
		if (now - lastStatSample) >= 5 then
			lastStatSample = now
			pcall(collectProgressSnapshot, false)
		end

		if webhookHeartbeatEnabled and (now - lastHeartbeat) >= (webhookIntervalMin * 60) then
			lastHeartbeat = now
			task.spawn(function()
				sendProgressWebhook(nil, 0x5865F2, true)
			end)
		end

		task.wait(1)
	end
end)

