local function getTargetPlayerStatSummary(targetPlayer)
	local cashRate = targetPlayer:GetAttribute("CashPerSecond")
	local speedVal = targetPlayer:GetAttribute("SpeedPower")

	local ls = targetPlayer:FindFirstChild("leaderstats")
	if ls then
		if not cashRate then
			local cs = ls:FindFirstChild("Cash/s") or ls:FindFirstChild("CashPerSec")
			if cs and cs:IsA("ValueBase") then
				cashRate = cs.Value
			end
		end
		if not speedVal then
			local sp = ls:FindFirstChild("Speed")
			if sp and sp:IsA("ValueBase") then
				speedVal = sp.Value
			end
		end
	end

	local parts = {}
	if cashRate ~= nil then
		local formattedRate = typeof(cashRate) == "number" and formatAbbreviatedNumber(cashRate) or tostring(cashRate)
		formattedRate = formattedRate:gsub("^%+", ""):gsub("^%$", ""):gsub("/s$", "")
		table.insert(parts, "$" .. formattedRate .. "/s")
	end
	if speedVal ~= nil then
		local formattedSpeed = typeof(speedVal) == "number" and formatAbbreviatedNumber(speedVal) or tostring(speedVal)
		table.insert(parts, formattedSpeed .. " SPD")
	end

	return table.concat(parts, " · ")
end

local function removePlayerEsp(targetPlayer)
