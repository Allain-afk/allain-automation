local espContainer = Instance.new("Folder")
espContainer.Name = "__AllainESPContainer"
espContainer.Parent = espParent

local espObjects = {}

local function getTargetPlayerStatSummary(targetPlayer)
	local cashRate = targetPlayer:GetAttribute("CashPerSecond")
	local speedVal = targetPlayer:GetAttribute("SpeedPower")

	local ls = targetPlayer:FindFirstChild("leaderstats")
	if ls then
		if not cashRate then
			local cs = ls:FindFirstChild("Cash/s") or ls:FindFirstChild("CashPerSec")
			if cs and cs:IsA("ValueBase") then
				cashRate = cs.Value
			end
		end
		if not speedVal then
			local sp = ls:FindFirstChild("Speed")
			if sp and sp:IsA("ValueBase") then
				speedVal = sp.Value
			end
		end
	end

	local parts = {}
	if cashRate ~= nil then
		local formattedRate = typeof(cashRate) == "number" and formatAbbreviatedNumber(cashRate) or tostring(cashRate)
		formattedRate = formattedRate:gsub("^%+", ""):gsub("^%$", ""):gsub("/s$", "")
		table.insert(parts, "$" .. formattedRate .. "/s")
	end
	if speedVal ~= nil then
		local formattedSpeed = typeof(speedVal) == "number" and formatAbbreviatedNumber(speedVal) or tostring(speedVal)
		table.insert(parts, formattedSpeed .. " SPD")
	end

	return table.concat(parts, " · ")
end

local function removePlayerEsp(targetPlayer)
	local entry = espObjects[targetPlayer]
	if entry then
		pcall(function()
			if entry.Highlight then
				entry.Highlight:Destroy()
			end
			if entry.Billboard then
				entry.Billboard:Destroy()
			end
		end)
		espObjects[targetPlayer] = nil
	end
end

local function createOrGetPlayerEsp(targetPlayer)
	local entry = espObjects[targetPlayer]
	if entry then
		return entry
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_HL_" .. targetPlayer.Name
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Parent = espContainer

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_BB_" .. targetPlayer.Name
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.fromOffset(240, 48)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.ResetOnSpawn = false
	billboard.Enabled = false
	billboard.Parent = espContainer

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "InfoLabel"
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.FontFace = Library.Scheme.Font or Font.fromEnum(Enum.Font.GothamBold)
	textLabel.TextSize = espTextSize
	textLabel.TextColor3 = espColor
	textLabel.TextStrokeTransparency = 0.25
	textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	textLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	textLabel.Text = ""
	textLabel.Parent = billboard

	entry = {
		Highlight = highlight,
		Billboard = billboard,
		Label = textLabel,
	}
	espObjects[targetPlayer] = entry
	return entry
end

local function updateAllEsp()
	if not espEnabled or Library.Unloaded then
		for _, entry in pairs(espObjects) do
			if entry.Highlight then
				entry.Highlight.Enabled = false
			end
			if entry.Billboard then
				entry.Billboard.Enabled = false
			end
		end
		return
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			local char = targetPlayer.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local head = char and (char:FindFirstChild("Head") or rootPart)

			if char and rootPart and head and (not humanoid or humanoid.Health > 0) then
				local dist = myRoot and (rootPart.Position - myRoot.Position).Magnitude or 0
				if dist <= espMaxDistance then
					local entry = createOrGetPlayerEsp(targetPlayer)

					-- Update Highlight
					if espHighlightEnabled then
						entry.Highlight.Adornee = char
						entry.Highlight.FillColor = espColor
						entry.Highlight.OutlineColor = espColor
						entry.Highlight.FillTransparency = espFillTrans
						entry.Highlight.OutlineTransparency = espOutlineTrans
						entry.Highlight.Enabled = true
					else
						entry.Highlight.Enabled = false
					end

					-- Update Overhead Tag
					if espBillboardEnabled then
						local topParts = {}
						if espInfoSelected.Name then
							local disp = targetPlayer.DisplayName
							if disp and disp ~= "" and disp ~= targetPlayer.Name then
								table.insert(topParts, string.format("%s (@%s)", disp, targetPlayer.Name))
							else
								table.insert(topParts, targetPlayer.Name)
							end
						end
						if espInfoSelected.Distance then
							table.insert(topParts, string.format("[%dm]", math.floor(dist + 0.5)))
						end
						if espInfoSelected.Health and humanoid then
							local hpPct = math.clamp(math.floor((humanoid.Health / math.max(humanoid.MaxHealth, 1)) * 100 + 0.5), 0, 100)
							table.insert(topParts, string.format("(%d%% HP)", hpPct))
						end

						local lines = {}
						if #topParts > 0 then
							table.insert(lines, table.concat(topParts, " "))
						end
						if espInfoSelected.Stats then
							local statLine = getTargetPlayerStatSummary(targetPlayer)
							if statLine ~= "" then
								table.insert(lines, statLine)
							end
						end

						if #lines > 0 then
							entry.Billboard.Adornee = head
							entry.Label.TextColor3 = espColor
							entry.Label.TextSize = espTextSize
							entry.Label.Text = table.concat(lines, "\n")
							entry.Billboard.Enabled = true
						else
							entry.Billboard.Enabled = false
						end
					else
						entry.Billboard.Enabled = false
					end
				else
					local entry = espObjects[targetPlayer]
					if entry then
						entry.Highlight.Enabled = false
						entry.Billboard.Enabled = false
					end
				end
			else
				local entry = espObjects[targetPlayer]
				if entry then
					entry.Highlight.Enabled = false
					entry.Billboard.Enabled = false
				end
			end
		end
	end
end

