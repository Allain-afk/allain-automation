	void = 0x9146FF,
	omega = 0xFF2D2D,
	spectral = 0x78FFD2,
	ethereal = 0xD7F5FF,
}

local function isRaritySelectedInTable(rarityStr, selectionTable)
	if typeof(rarityStr) ~= "string" or rarityStr == "" then
		return false
	end
	local lower = rarityStr:lower()
	for selectedKey, isSelected in pairs(selectionTable) do
		if isSelected and typeof(selectedKey) == "string" then
			local selLower = selectedKey:lower()
			if selLower == lower or (selLower == "mythic" and lower == "mythical") or (selLower == "mythical" and lower == "mythic") then
				return true
			end
		end
	end
	return false
end

local function playClientAlertSound(soundId, volume, pitch)
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = soundId or "rbxassetid://4590657391"
		s.Volume = volume or 1.5
		s.PlaybackSpeed = pitch or 1
		s.Parent = espContainer
		s:Play()
		task.delay(4, function()
			if s and s.Parent then
				s:Destroy()
			end
		end)
	end)
end

