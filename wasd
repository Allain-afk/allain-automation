				entry.Billboard.Adornee = eggPart
				entry.Label.TextColor3 = color
				entry.Label.TextSize = espTextSize
				entry.Label.Text = titleText .. (#subParts > 0 and ("\n" .. table.concat(subParts, " · ")) or "")
