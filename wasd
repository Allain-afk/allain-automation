		end
	end)
end)

Library:OnUnload(function()
	if env.__AllainWASDLibrary == Library then
		env.__AllainWASDLibrary = nil
	end
	env.__AllainWASDLoading = false
	isRunning = false
	antiAfkEnabled = false
	autoReconnectEnabled = false
	if lowPowerEnabled then
		applyLowPowerState(false)
	end
	if renderSteppedConn then
		renderSteppedConn:Disconnect()
	end
	if idledConnection then
		idledConnection:Disconnect()
	end
	if teleportConnection then
		teleportConnection:Disconnect()
	end
	if errorChangedConnection then
		errorChangedConnection:Disconnect()
	end
	if promptOverlayConnection then
		promptOverlayConnection:Disconnect()
	end
	if playerRemovingConn then
		playerRemovingConn:Disconnect()
	end
	if espContainer then
		pcall(function()
			espContainer:Destroy()
		end)
	end
	table.clear(espObjects)
	table.clear(petEspObjects)
	table.clear(eggEspObjects)
	table.clear(guardEspObjects)
	setInternalIdledConnections(true)
	for _, dir in ipairs(directions) do
		sendKeyState(dir.keyCode, false)
	end
	highlightKey(nil)
end)
