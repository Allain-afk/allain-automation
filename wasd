	end
end

local directions = {
	{ key = "W", keyCode = Enum.KeyCode.W, label = "Forward (W)", getOffset = function(cf, dist) return cf.LookVector * dist end },
	{ key = "A", keyCode = Enum.KeyCode.A, label = "Left (A)", getOffset = function(cf, dist) return -cf.RightVector * dist end },
	{ key = "S", keyCode = Enum.KeyCode.S, label = "Backward (S)", getOffset = function(cf, dist) return -cf.LookVector * dist end },
	{ key = "D", keyCode = Enum.KeyCode.D, label = "Right (D)", getOffset = function(cf, dist) return cf.RightVector * dist end },
