--============================================================================--
--// Safe Auto-Progression Engine (Pet, Pickaxe, Trail, Plot, Treadmill)
--============================================================================--

local runAutoProgressionStep
do
	local ReplicatedStorage = cloneref(game:GetService("ReplicatedStorage"))

	local function triggerGuiButton(btn)
		if not btn or not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
			return false
		end
		local fired = false
		if typeof(firesignal) == "function" then
			pcall(function()
				firesignal(btn.Activated)
				fired = true
			end)
			pcall(function()
				firesignal(btn.MouseButton1Click)
				fired = true
			end)
		end
		local getconns = getconnections or get_signal_cons
		if getconns then
			for _, sig in ipairs({ btn.Activated, btn.MouseButton1Click, btn.MouseButton1Down }) do
				pcall(function()
					for _, conn in pairs(getconns(sig)) do
						if conn.Fire then
							conn:Fire()
							fired = true
						elseif conn.Function then
							task.spawn(conn.Function)
							fired = true
						end
					end
				end)
			end
		end
		if not fired and VirtualInputManager and btn.AbsolutePosition and btn.AbsoluteSize then
			pcall(function()
				local center = btn.AbsolutePosition + btn.AbsoluteSize / 2
				VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
				task.wait(0.04)
				VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
				fired = true
			end)
		end
		return fired
	end

	local function isAutoSwingActive(autoSwingObj)
		if not autoSwingObj then return false end
		local colorAlpha = autoSwingObj:FindFirstChild("AutoSwingColorAlpha")
		if not colorAlpha then
			colorAlpha = autoSwingObj:FindFirstChildWhichIsA("NumberValue") or autoSwingObj:FindFirstChildWhichIsA("IntValue")
		end
		if colorAlpha and typeof(colorAlpha.Value) == "number" then
			return colorAlpha.Value > 0.5
		end
		local attr = autoSwingObj:GetAttribute("AutoSwingColorAlpha") or autoSwingObj:GetAttribute("Active") or autoSwingObj:GetAttribute("Enabled")
		if typeof(attr) == "number" then
			return attr > 0.5
		elseif typeof(attr) == "boolean" then
			return attr
		end
		return false
	end

	local function findAutoSwingElement()
		local pGui = player:FindFirstChild("PlayerGui")
		if not pGui then return nil, nil end
		local mainGui = pGui:FindFirstChild("MainGUI")
		local autoSwing = mainGui and mainGui:FindFirstChild("AutoSwing", true)
		if not autoSwing then
			for _, desc in ipairs(pGui:GetDescendants()) do
				local n = desc.Name:lower():gsub("[%s_]", "")
				if n == "autoswing" then
					autoSwing = desc
					break
				end
			end
		end
		if not autoSwing then return nil, nil end

		local btn = nil
		if autoSwing:IsA("GuiButton") then
			btn = autoSwing
		else
			btn = autoSwing:FindFirstChildWhichIsA("GuiButton")
				or autoSwing:FindFirstChild("Button")
				or autoSwing:FindFirstChild("Toggle")
				or autoSwing:FindFirstChildWhichIsA("GuiButton", true)
		end
		return autoSwing, btn
	end

	local function enableInGameAutoSwing()
		local autoSwingObj, btn = findAutoSwingElement()
		if not autoSwingObj then
			if AutoSwingStatusLabel then
				AutoSwingStatusLabel:SetText("Auto Swing: Not Found")
			end
			return false
		end

		if isAutoSwingActive(autoSwingObj) then
			if AutoSwingStatusLabel then
				AutoSwingStatusLabel:SetText("Auto Swing: Active (In-Game)")
			end
			return true
		end

		if btn then
			triggerGuiButton(btn)
			task.wait(0.15)
			local active = isAutoSwingActive(autoSwingObj)
			if AutoSwingStatusLabel then
				AutoSwingStatusLabel:SetText(active and "Auto Swing: Active (In-Game)" or "Auto Swing: Enabled")
			end
			return active
		end
		return false
	end

	local function parseOwnedTierSet(csvStr)
		local set = {}
		local maxTier = 0
		if typeof(csvStr) == "number" then
			set[csvStr] = true
			return set, csvStr
		end
		if typeof(csvStr) == "string" then
			for numStr in csvStr:gmatch("(%d+)") do
				local n = tonumber(numStr)
				if n then
					set[n] = true
					if n > maxTier then
						maxTier = n
					end
				end
			end
		end
		return set, maxTier
	end

	local function findOwnedPlot()
		local plotsFolder = workspace:FindFirstChild("Plots")
		if not plotsFolder then
			return nil
		end
		for _, plot in ipairs(plotsFolder:GetChildren()) do
			if plot:GetAttribute("OwnerUserId") == player.UserId then
				return plot
			end
		end
		return nil
	end

	local function readChildLabelText(parentInst, childName)
		if not parentInst then
			return ""
		end
		local ch = parentInst:FindFirstChild(childName)
		if ch and (ch:IsA("TextLabel") or ch:IsA("TextButton")) then
			return (ch.Text or ""):gsub("<[^>]+>", ""):match("^%s*(.-)%s*$") or ""
		end
		return ""
	end

	local lastEquipBestTime = 0

	runAutoProgressionStep = function(forceImmediate)
	local rawCash = player:GetAttribute("Cash")
	local currentCash = (typeof(rawCash) == "number" and rawCash) or parseAbbreviatedNumber(rawCash) or 0
	local playerGui = player:FindFirstChild("PlayerGui")
	local mainGui = playerGui and playerGui:FindFirstChild("MainGUI")
	local framesFolder = mainGui and mainGui:FindFirstChild("Frames")
	local myPlot = findOwnedPlot()

	-- 1. Auto Equip Best Pet
	if myPlot then
		local placed = tonumber(myPlot:GetAttribute("AnimalsPlaced")) or 0
		local maxPlaced = tonumber(myPlot:GetAttribute("MaxAnimals")) or 16
		local plotCps = tonumber(myPlot:GetAttribute("CashPerSecond")) or 0
		local basePetStatus = string.format("%d/%d placed ($%s/s)", placed, maxPlaced, formatAbbreviatedNumber(plotCps))

		if autoEquipBestPetEnabled then
			local now = os.clock()
			if forceImmediate or (now - lastEquipBestTime) >= math.max(autoProgressionInterval, 10) then
				lastEquipBestTime = now
				local equipBestBtn = nil
				if playerGui then
					for _, desc in ipairs(playerGui:GetDescendants()) do
						if desc:IsA("TextButton") or desc:IsA("ImageButton") then
							local rel = desc:GetFullName()
							if not rel:find("RobloxGui") and not rel:find("Alexandria") then
								local nLow = desc.Name:lower()
								local tLow = (desc:IsA("TextButton") and desc.Text or ""):lower()
								if not tLow or tLow == "" then
									local subLbl = desc:FindFirstChildWhichIsA("TextLabel", true)
									if subLbl then
										tLow = (subLbl.Text or ""):lower()
									end
								end
								if nLow == "equipbest" or nLow == "equipbestbutton" or tLow:find("equip best") or tLow:find("best pet") then
									equipBestBtn = desc
									break
								end
							end
						end
					end
				end
				if equipBestBtn then
					triggerGuiButton(equipBestBtn)
					AutoPetStatusLabel:SetText("Best Pet: Active · " .. basePetStatus)
				else
					AutoPetStatusLabel:SetText("Best Pet: Monitoring · " .. basePetStatus)
				end
			else
				AutoPetStatusLabel:SetText("Best Pet: Active · " .. basePetStatus)
			end
		else
			AutoPetStatusLabel:SetText("Best Pet: Off (" .. basePetStatus .. ")")
		end
	else
		AutoPetStatusLabel:SetText(autoEquipBestPetEnabled and "Best Pet: Waiting for plot..." or "Best Pet: Off")
	end

	-- 2. Auto Buy & Equip Best Pickaxe
	local equippedPickaxe = tonumber(player:GetAttribute("PickaxeTier")) or 1
	local ownedPickaxesSet, maxOwnedPickaxe = parseOwnedTierSet(player:GetAttribute("OwnedPickaxes"))
	if maxOwnedPickaxe < equippedPickaxe then
		maxOwnedPickaxe = equippedPickaxe
	end

	local pickaxesFrame = framesFolder and framesFolder:FindFirstChild("Pickaxes")
	local pickaxeScroll = pickaxesFrame and pickaxesFrame:FindFirstChild("ScrollingFrame")
	if pickaxeScroll then
		local bestAffordableTier = nil
		local bestAffordableBtn = nil
		local bestAffordableCost = 0
		local highestOwnedEquipBtn = nil

		for _, child in ipairs(pickaxeScroll:GetChildren()) do
			local tierNum = tonumber(child.Name:match("^Tier(%d+)$"))
			local container = tierNum and child:FindFirstChild("Container")
			if tierNum and container then
				if tierNum == maxOwnedPickaxe and maxOwnedPickaxe > equippedPickaxe then
					local eqBtn = container:FindFirstChild("Equip")
					if eqBtn then
						highestOwnedEquipBtn = eqBtn
					end
				end
				if not ownedPickaxesSet[tierNum] then
					local purchaseBtn = container:FindFirstChild("Purchase")
					local costTitle = purchaseBtn and readChildLabelText(purchaseBtn, "Title") or ""
					local costNum = parseAbbreviatedNumber(costTitle)
					if purchaseBtn and costNum and costNum > 0 and currentCash >= costNum then
						if not bestAffordableTier or tierNum > bestAffordableTier then
							bestAffordableTier = tierNum
							bestAffordableBtn = purchaseBtn
							bestAffordableCost = costNum
						end
					end
				end
			end
		end

		if autoBuyPickaxeEnabled then
			if bestAffordableBtn and bestAffordableTier then
				triggerGuiButton(bestAffordableBtn)
				local req = ReplicatedStorage:FindFirstChild("PickaxeShopRequest")
				if req and req:IsA("RemoteEvent") then
					pcall(function()
						req:FireServer("Purchase", bestAffordableTier)
					end)
				end
				AutoPickaxeStatusLabel:SetText(string.format("Pickaxe: Buying Tier %d ($%s)", bestAffordableTier, formatAbbreviatedNumber(bestAffordableCost)))
			elseif highestOwnedEquipBtn and maxOwnedPickaxe > equippedPickaxe then
				triggerGuiButton(highestOwnedEquipBtn)
				local req = ReplicatedStorage:FindFirstChild("PickaxeShopRequest")
				if req and req:IsA("RemoteEvent") then
					pcall(function()
						req:FireServer("Equip", maxOwnedPickaxe)
					end)
				end
				AutoPickaxeStatusLabel:SetText(string.format("Pickaxe: Equipping Tier %d", maxOwnedPickaxe))
			else
				AutoPickaxeStatusLabel:SetText(string.format("Pickaxe: Tier %d Equipped (Max Owned: %d)", equippedPickaxe, maxOwnedPickaxe))
			end
		else
			AutoPickaxeStatusLabel:SetText(string.format("Pickaxe: Tier %d (Auto Off)", equippedPickaxe))
		end
	else
		AutoPickaxeStatusLabel:SetText(string.format("Pickaxe: Tier %d", equippedPickaxe))
	end

	-- 3. Auto Buy & Equip Best Trail
	local equippedTrail = tonumber(player:GetAttribute("EquippedTrail")) or 0
	local ownedTrailsSet, maxOwnedTrail = parseOwnedTierSet(player:GetAttribute("OwnedTrails"))
	if maxOwnedTrail < equippedTrail then
		maxOwnedTrail = equippedTrail
	end

	local trailsFrame = framesFolder and (
		framesFolder:FindFirstChild("Trails")
		or framesFolder:FindFirstChild("SpeedShop")
		or framesFolder:FindFirstChild("TrailShop")
		or framesFolder:FindFirstChild("Trail")
	)
	local trailScroll = trailsFrame and trailsFrame:FindFirstChild("ScrollingFrame")
	if trailScroll then
		local bestTrailTier = nil
		local bestTrailBtn = nil
		local bestTrailCost = 0
		local highestTrailEquipBtn = nil

		for _, child in ipairs(trailScroll:GetChildren()) do
			local tierNum = tonumber(child.Name:match("^Tier(%d+)$"))
			local container = tierNum and child:FindFirstChild("Container")
			if tierNum and container then
				if tierNum == maxOwnedTrail and maxOwnedTrail > equippedTrail then
					local eqBtn = container:FindFirstChild("Equip")
					if eqBtn then
						highestTrailEquipBtn = eqBtn
					end
				end
				if not ownedTrailsSet[tierNum] then
					local purchaseBtn = container:FindFirstChild("Purchase")
					local costTitle = purchaseBtn and (readChildLabelText(purchaseBtn, "Title") ~= "" and readChildLabelText(purchaseBtn, "Title") or readChildLabelText(purchaseBtn, "Price")) or ""
					local costNum = parseAbbreviatedNumber(costTitle)
					if purchaseBtn and costNum and costNum > 0 and currentCash >= costNum then
						if not bestTrailTier or tierNum > bestTrailTier then
							bestTrailTier = tierNum
							bestTrailBtn = purchaseBtn
							bestTrailCost = costNum
						end
					end
				end
			end
		end

		if autoBuyTrailEnabled then
			if bestTrailBtn and bestTrailTier then
				triggerGuiButton(bestTrailBtn)
				local req = ReplicatedStorage:FindFirstChild("TrailShopRequest")
				if req and req:IsA("RemoteEvent") then
					pcall(function()
						req:FireServer("Purchase", bestTrailTier)
					end)
				end
				AutoTrailStatusLabel:SetText(string.format("Trail: Buying Tier %d ($%s)", bestTrailTier, formatAbbreviatedNumber(bestTrailCost)))
			elseif highestTrailEquipBtn and maxOwnedTrail > equippedTrail then
				triggerGuiButton(highestTrailEquipBtn)
				local req = ReplicatedStorage:FindFirstChild("TrailShopRequest")
				if req and req:IsA("RemoteEvent") then
					pcall(function()
						req:FireServer("Equip", maxOwnedTrail)
					end)
				end
				AutoTrailStatusLabel:SetText(string.format("Trail: Equipping Tier %d", maxOwnedTrail))
			else
				AutoTrailStatusLabel:SetText(string.format("Trail: Tier %d Equipped (Max Owned: %d)", equippedTrail, maxOwnedTrail))
			end
		else
			AutoTrailStatusLabel:SetText(string.format("Trail: Tier %d (Auto Off)", equippedTrail))
		end
	else
		AutoTrailStatusLabel:SetText(string.format("Trail: Tier %d (Max Owned: %d)", equippedTrail, maxOwnedTrail))
	end

	-- 4. Auto Upgrade Plot
	local upgradeBoard = playerGui and playerGui:FindFirstChild("UpgradeBoardGui")
	local plotLevelText = upgradeBoard and readChildLabelText(upgradeBoard, "Level") or ""
	local plotPurchaseBtn = upgradeBoard and upgradeBoard:FindFirstChild("Purchase")
	local plotPriceText = plotPurchaseBtn and readChildLabelText(plotPurchaseBtn, "Price") or ""

	if plotLevelText == "" and myPlot then
		plotLevelText = "Lv. " .. tostring(myPlot:GetAttribute("PlotLevel") or "?")
	end

	local isPlotMax = plotLevelText:upper():find("MAX") ~= nil or plotPriceText:upper():find("MAX") ~= nil
	if isPlotMax then
		AutoPlotStatusLabel:SetText("Plot: " .. (plotLevelText ~= "" and plotLevelText or "MAX"))
	else
		local plotCost = parseAbbreviatedNumber(plotPriceText)
		if autoUpgradePlotEnabled and plotCost and plotCost > 0 and currentCash >= plotCost then
			if plotPurchaseBtn then
				triggerGuiButton(plotPurchaseBtn)
			end
			local req = ReplicatedStorage:FindFirstChild("UpgradePlotRequest")
			if req and req:IsA("RemoteEvent") then
				pcall(function()
					req:FireServer()
				end)
			end
			AutoPlotStatusLabel:SetText(string.format("Plot: Upgrading! (%s · %s)", plotLevelText, plotPriceText))
		else
			local suffix = plotPriceText ~= "" and (" · Next: " .. plotPriceText) or ""
			AutoPlotStatusLabel:SetText("Plot: " .. (plotLevelText ~= "" and plotLevelText or "Unknown") .. suffix)
		end
	end

	-- 5. Auto Upgrade Treadmill
	local treadBoard = playerGui and playerGui:FindFirstChild("TreadmillBoardGui")
	local treadLevelText = treadBoard and readChildLabelText(treadBoard, "Level") or ""
	local treadPurchaseBtn = treadBoard and treadBoard:FindFirstChild("Purchase")
	local treadPriceText = treadPurchaseBtn and readChildLabelText(treadPurchaseBtn, "Price") or ""
	local treadUnlocked = myPlot and (myPlot:GetAttribute("TreadmillUnlocked") == true)

	if treadLevelText == "" and myPlot then
		treadLevelText = "Lv. " .. tostring(myPlot:GetAttribute("TreadmillLevel") or "?")
	end

	local isTreadMax = treadLevelText:upper():find("MAX") ~= nil or treadPriceText:upper():find("MAX") ~= nil
	if isTreadMax then
		AutoTreadmillStatusLabel:SetText("Treadmill: " .. (treadLevelText ~= "" and treadLevelText or "MAX"))
	else
		local treadCost = parseAbbreviatedNumber(treadPriceText)
		if autoUpgradeTreadmillEnabled and treadCost and treadCost > 0 and currentCash >= treadCost then
			if treadPurchaseBtn then
				triggerGuiButton(treadPurchaseBtn)
			end
			local reqName = (myPlot and not treadUnlocked) and "UnlockTreadmillRequest" or "UpgradeTreadmillRequest"
			local req = ReplicatedStorage:FindFirstChild(reqName)
			if req and req:IsA("RemoteEvent") then
				pcall(function()
					req:FireServer()
				end)
			end
			AutoTreadmillStatusLabel:SetText(string.format("Treadmill: Upgrading! (%s · %s)", treadLevelText, treadPriceText))
		else
			local suffix = treadPriceText ~= "" and (" · Next: " .. treadPriceText) or ""
			AutoTreadmillStatusLabel:SetText("Treadmill: " .. (treadLevelText ~= "" and treadLevelText or "Unknown") .. suffix)
		end
	end

	-- 6. In-Game Auto Swing (Built-in Auto Turn On)
	if autoSwingEnabled then
		pcall(enableInGameAutoSwing)
	elseif AutoSwingStatusLabel then
		AutoSwingStatusLabel:SetText("Auto Swing: Off")
	end
	end
end

