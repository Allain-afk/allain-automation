local function applyLowPowerState(enabled)
	pcall(function()
		RunService:Set3dRenderingEnabled(not enabled)
	end)
	local setFps = setfpscap or set_fps_cap
	if setFps then
		pcall(function()
			setFps(enabled and afkFpsCap or 60)
		end)
	end
end

local function postDiscordEmbed(embedTable)
	local url = (webhookUrl or ""):match("^%s*(.-)%s*$")
	if url == "" or (not url:find("^https://discord%.com/api/webhooks/") and not url:find("^https://discordapp%.com/api/webhooks/")) then
		return false, "Invalid or empty Discord Webhook URL"
	end

	local httpRequest = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
	if not httpRequest then
		return false, "Executor does not support HTTP requests"
	end

	local payload = {
		username = "Allain-afk Auto-Mover",
		embeds = { embedTable },
	}

	local ok, err = pcall(function()
		httpRequest({
			Url = url,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode(payload),
		})
	end)

	return ok, err
end

local function sendProgressWebhook(customTitle, customColor, isReportReset)
	local stats = collectProgressSnapshot(isReportReset)
	return postDiscordEmbed({
		title = customTitle or ("Progress for " .. tostring(player.Name)),
		description = "Playing for " .. formatShortDuration(os.clock() - sessionStartTime),
		color = customColor or 0x5865F2,
		fields = {
			{ name = "Cash", value = stats.cash, inline = true },
			{ name = "Speed", value = stats.speed, inline = true },
			{ name = "Pets", value = stats.pets, inline = true },
			{ name = "This session", value = stats.session, inline = true },
			{ name = "Candy", value = stats.candy, inline = true },
			{ name = "Doing", value = stats.doing, inline = true },
		},
	})
end

local function sendEventWebhook(title, description, colorHex)
	local stats = collectProgressSnapshot(false)
	return postDiscordEmbed({
		title = title,
		description = description .. "\nPlaying for " .. formatShortDuration(os.clock() - sessionStartTime),
		color = colorHex or 0x5865F2,
		fields = {
			{ name = "Cash", value = stats.cash, inline = true },
			{ name = "Speed", value = stats.speed, inline = true },
			{ name = "Pets", value = stats.pets, inline = true },
