local function queueScriptForTeleport()
	if env.__AllainTeleportQueued or hasQueuedTeleport or not autoReconnectEnabled or Library.Unloaded then
		return
	end
	local queueFunc = getQueueOnTeleport()
	if queueFunc then
		local ok = pcall(function()
			queueFunc(string.format([[
local env = (getgenv and getgenv()) or shared
if env.__AllainAutoExecFired then
	return
end
env.__AllainAutoExecFired = true
if not game:IsLoaded() then
