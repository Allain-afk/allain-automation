			else
				local entry = eggEspObjects[eggPart]
				if entry then
					entry.Highlight.Enabled = false
					entry.Billboard.Enabled = false
				end
			end
		else
			local entry = eggEspObjects[eggPart]
			if entry then
				entry.Highlight.Enabled = false
				entry.Billboard.Enabled = false
