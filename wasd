local function extractPetOverheadInfo(petModel, rootPart)
	local cashPerSecText = nil
	local timerText = nil
	local rarityText = nil
	local mutationText = nil

	local attachment = rootPart and rootPart:FindFirstChild("AnimalOverheadAttachment")
	local overhead = attachment and attachment:FindFirstChild("AnimalOverhead")
	if overhead then
		local cpsFrame = overhead:FindFirstChild("CashPerSecond")
		local cpsLabel = cpsFrame and (cpsFrame:FindFirstChild("CashPerSecond") or cpsFrame:FindFirstChildWhichIsA("TextLabel"))
		if cpsLabel and cpsLabel:IsA("TextLabel") and cpsLabel.Text ~= "" then
			cashPerSecText = cpsLabel.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
		end

		local timerFrame = overhead:FindFirstChild("SelfDestructTimer")
		local timerLabel = timerFrame and (timerFrame:FindFirstChild("CashPerSecond") or timerFrame:FindFirstChildWhichIsA("TextLabel"))
		if timerLabel and timerLabel:IsA("TextLabel") and timerLabel.Text ~= "" then
			timerText = timerLabel.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
		end

		local rarityFrame = overhead:FindFirstChild("Rarity")
		local rarityLabel = rarityFrame and (rarityFrame:FindFirstChild("RarityLabel") or rarityFrame:FindFirstChildWhichIsA("TextLabel"))
		if rarityLabel and rarityLabel:IsA("TextLabel") and rarityLabel.Text ~= "" then
			rarityText = rarityLabel.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
		end

		local mutLabel = overhead:FindFirstChild("Mutation")
		if mutLabel and mutLabel:IsA("TextLabel") and mutLabel.Visible and mutLabel.Text ~= "" then
			mutationText = mutLabel.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
		end
	end

	return cashPerSecText, timerText, rarityText, mutationText
end

local function isPetRarityAllowed(rarityStr)
	if typeof(rarityStr) ~= "string" or rarityStr == "" then
		return true
	end
	local lower = rarityStr:lower()
	-- Auto-register any new/event rarity into the dropdown if discovered in-game
	if not knownPetRarities[lower] and lower ~= "mythical" then
		knownPetRarities[lower] = rarityStr
		table.insert(petRarityList, rarityStr)
		if Options.PetRarityFilter then
			pcall(function()
				Options.PetRarityFilter:AddValues(rarityStr)
			end)
		end
	end

	for selectedKey, isSelected in pairs(petRaritySelected) do
		if isSelected and typeof(selectedKey) == "string" then
			local selLower = selectedKey:lower()
			if selLower == lower or (selLower == "mythic" and lower == "mythical") or (selLower == "mythical" and lower == "mythic") then
				return true
			end
		end
	end
	return false
end

local function updateAllPetEsp()
	local pickupsFolder = workspace:FindFirstChild("AnimalPickups")

	if not petEspEnabled or Library.Unloaded or not pickupsFolder then
		for _, entry in pairs(petEspObjects) do
			if entry.Highlight then
				entry.Highlight.Enabled = false
			end
			if entry.Billboard then
				entry.Billboard.Enabled = false
			end
		end
		return
	end

	-- Clean up despawned / picked-up pets
	for petModel in pairs(petEspObjects) do
		if not petModel.Parent or petModel.Parent ~= pickupsFolder then
			removePetEsp(petModel)
		end
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, petModel in ipairs(pickupsFolder:GetChildren()) do
		if petModel:IsA("Model") or petModel:IsA("BasePart") then
			local rootPart = petModel:IsA("Model")
				and (petModel:FindFirstChild("RootPart") or petModel.PrimaryPart or petModel:FindFirstChildWhichIsA("BasePart"))
				or petModel

			if rootPart and rootPart:IsA("BasePart") then
				local dist = myRoot and (rootPart.Position - myRoot.Position).Magnitude or 0
				local animalName = petModel:GetAttribute("AnimalName") or petModel.Name
				local rarityAttr = petModel:GetAttribute("Rarity")
				local weightKg = petModel:GetAttribute("WeightKg")
				local weightBracket = petModel:GetAttribute("WeightBracket")

				local cpsText, timerText, rarityGuiText, mutationText = extractPetOverheadInfo(petModel, rootPart)
				local finalRarity = (rarityAttr and tostring(rarityAttr) ~= "" and tostring(rarityAttr)) or rarityGuiText or ""

				if dist <= petEspMaxDistance and isPetRarityAllowed(finalRarity) then
					local entry = createOrGetPetEsp(petModel)
					local color = getPetDisplayColor(finalRarity)

					-- Update Highlight
					if petEspHighlightEnabled then
						entry.Highlight.Adornee = petModel
						entry.Highlight.FillColor = color
						entry.Highlight.OutlineColor = color
						entry.Highlight.FillTransparency = espFillTrans
						entry.Highlight.OutlineTransparency = espOutlineTrans
						entry.Highlight.Enabled = true
					else
						entry.Highlight.Enabled = false
					end

					-- Update Overhead Tag
					if petEspBillboardEnabled then
						local line1 = {}
						if petEspInfoSelected.Name then
							local cleanName = formatPetModelName(tostring(animalName))
							if mutationText and mutationText ~= "" then
								cleanName = string.format("%s [%s]", cleanName, mutationText)
							end
							table.insert(line1, cleanName)
						end
						if petEspInfoSelected.Rarity and finalRarity ~= "" then
							table.insert(line1, string.format("(%s)", finalRarity))
						end
						if petEspInfoSelected.Distance then
							table.insert(line1, string.format("[%dm]", math.floor(dist + 0.5)))
						end

						local line2 = {}
						if petEspInfoSelected["Cash/s"] and cpsText and cpsText ~= "" then
							table.insert(line2, cpsText)
						end
						if petEspInfoSelected.Weight and weightKg ~= nil then
							local wNum = tonumber(weightKg)
							local wStr = wNum and string.format("%.1f KG", wNum):gsub("%.0 KG", " KG") or (tostring(weightKg) .. " KG")
							if weightBracket and tostring(weightBracket) ~= "" then
								wStr = wStr .. " [" .. tostring(weightBracket) .. "]"
							end
							table.insert(line2, wStr)
						end
						if petEspInfoSelected.Timer and timerText and timerText ~= "" then
							table.insert(line2, "⏱ " .. timerText)
						end

						local lines = {}
						if #line1 > 0 then
							table.insert(lines, table.concat(line1, " "))
						end
						if #line2 > 0 then
							table.insert(lines, table.concat(line2, " · "))
						end

						if #lines > 0 then
							entry.Billboard.Adornee = rootPart
							entry.Label.TextColor3 = color
							entry.Label.TextSize = espTextSize
							entry.Label.Text = table.concat(lines, "\n")
							entry.Billboard.Enabled = true
						else
							entry.Billboard.Enabled = false
						end
					else
						entry.Billboard.Enabled = false
					end
				else
					local entry = petEspObjects[petModel]
					if entry then
						entry.Highlight.Enabled = false
						entry.Billboard.Enabled = false
					end
				end
			end
		end
	end
end

