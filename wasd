			end)
			for _, z in ipairs(zoneList) do
				local eggsF = z:FindFirstChild("Eggs")
				if eggsF and #eggsF:GetChildren() > 0 then
					local eggNames = {}
					for _, ec in ipairs(eggsF:GetChildren()) do
						local ep = ec:FindFirstChild("Egg") or (ec:IsA("BasePart") and ec)
						local eName = ep and (ep:GetAttribute("EggInfoName") or ep:GetAttribute("EggType")) or ec.Name
						local luck = ep and (ep:GetAttribute("EggInfoLuck") or ep:GetAttribute("HatchLuck")) or ""
						local hp = ep and ep:GetAttribute("Health") or ""
						table.insert(eggNames, string.format("%s [L:%s, HP:%s]", tostring(eName), tostring(luck), tostring(hp)))
					end
					table.insert(p3Lines, string.format("[%s]: %s", z.Name, table.concat(eggNames, " | ")))
				end
			end
		end

		local dump3 = table.concat(p3Lines, "\n")
		if #dump3 > 3800 then dump3 = dump3:sub(1, 3800) .. "\n... (truncated)" end
		postDiscordEmbed({
			title = "Speed & Zone Diagnostics (Part 3/3: Egg Details)",
			description = "```text\n" .. dump3 .. "\n```",
			color = 0xFEE75C,
		})

		Library:Notify("3-Part Speed & Zone snapshot sent to Webhook!", 4)
	end)
end

