	Title = "WASD Auto-Mover",
	Footer = "Allain-afk · auto-mover",
	FooterRight = "v1.1",
	Username = true,
	Badge = "Idle",
	Size = UDim2.fromOffset(520, 380),
	Center = true,
	AutoShow = true,
})

local Tabs = {
	Mover = Window:AddTab("Auto-Mover", "footprints"),
}

--// Left Groupbox: Controls & Configuration \\--
local ControlsBox = Tabs.Mover:AddGroupbox({
