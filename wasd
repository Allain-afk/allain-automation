--// Right Groupbox: Live WASD Key Visualizer \\--
local VisualizerBox = Tabs.Mover:AddGroupbox({
	Side = "Right",
	Name = "Key Visualizer",
	IconName = "keyboard",
	Description = "Highlights the active movement direction.",
})

local StatusLabel = VisualizerBox:AddLabel("StatusLabel", {
	Text = "Status: Idle",
	DoesWrap = false,
})

VisualizerBox:AddDivider()

-- Custom WASD Keycap Widget embedded via AddUIPassthrough
local keysContainer = Instance.new("Frame")
keysContainer.Name = "WASDContainer"
keysContainer.Size = UDim2.new(1, 0, 1, 0)
keysContainer.BackgroundTransparency = 1

local keysFrame = Instance.new("Frame")
keysFrame.Name = "KeysGrid"
keysFrame.Size = UDim2.fromOffset(116, 76)
keysFrame.AnchorPoint = Vector2.new(0.5, 0.5)
keysFrame.Position = UDim2.fromScale(0.5, 0.5)
keysFrame.BackgroundTransparency = 1
keysFrame.Parent = keysContainer

local keyBoxes = {}
local keyLayout = {
	W = UDim2.fromOffset(40, 0),
	A = UDim2.fromOffset(0, 40),
	S = UDim2.fromOffset(40, 40),
	D = UDim2.fromOffset(80, 40),
}

local idleBgColor = Library.Scheme.MainColor or Color3.fromRGB(20, 20, 22)
local idleStrokeColor = Library.Scheme.OutlineColor or Color3.fromRGB(36, 36, 39)
local idleTextColor = Color3.fromRGB(160, 160, 170)
local activeBgColor = Library.Scheme.AccentColor or Color3.fromRGB(232, 232, 236)
local activeTextColor = Library.Scheme.BackgroundColor or Color3.fromRGB(14, 14, 15)

for keyName, pos in pairs(keyLayout) do
	local box = Instance.new("TextLabel")
	box.Name = "Key_" .. keyName
	box.Size = UDim2.fromOffset(36, 36)
	box.Position = pos
	box.BackgroundColor3 = idleBgColor
	box.BorderSizePixel = 0
	box.Text = keyName
	box.TextColor3 = idleTextColor
	box.FontFace = Library.Scheme.Font or Font.fromEnum(Enum.Font.GothamBold)
	box.TextSize = 14
	box.Parent = keysFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Library.CornerRadius or 6)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
	stroke.Color = idleStrokeColor
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = box

	keyBoxes[keyName] = {
		Label = box,
		Stroke = stroke,
	}
end

VisualizerBox:AddUIPassthrough("WASDVisualizer", {
	Instance = keysContainer,
	Height = 90,
})

local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function highlightKey(activeKey)
	for k, data in pairs(keyBoxes) do
		local isCurrent = (k == activeKey)
		TweenService:Create(data.Label, tweenInfo, {
			BackgroundColor3 = isCurrent and activeBgColor or idleBgColor,
			TextColor3 = isCurrent and activeTextColor or idleTextColor,
		}):Play()
		TweenService:Create(data.Stroke, tweenInfo, {
			Color = isCurrent and activeBgColor or idleStrokeColor,
		}):Play()
	end
end

--// Anti-AFK (Prevents Roblox 20-Minute Idle Kick / Error 278) \\--
local function pulseAntiAfk()
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
end

local function setInternalIdledConnections(enabled)
	local getconns = getconnections or get_signal_cons
	if getconns then
		pcall(function()
			for _, conn in pairs(getconns(player.Idled)) do
				if enabled then
					if conn.Enable then
						conn:Enable()
					end
				else
					if conn.Disable then
						conn:Disable()
					elseif conn.Disconnect then
						conn:Disconnect()
					end
				end
			end
		end)
	end
end

-- Disable Roblox's internal idle kick connection immediately if supported
setInternalIdledConnections(false)

-- Fallback hook on LocalPlayer.Idled
local idledConnection = player.Idled:Connect(function()
	if antiAfkEnabled and not Library.Unloaded then
		pulseAntiAfk()
	end
end)

--// WASD Movement Automation \\--
local directions = {
	{ key = "W", keyCode = Enum.KeyCode.W, label = "Forward (W)", getOffset = function(cf, dist) return cf.LookVector * dist end },
	{ key = "A", keyCode = Enum.KeyCode.A, label = "Left (A)", getOffset = function(cf, dist) return -cf.RightVector * dist end },
	{ key = "S", keyCode = Enum.KeyCode.S, label = "Backward (S)", getOffset = function(cf, dist) return -cf.LookVector * dist end },
	{ key = "D", keyCode = Enum.KeyCode.D, label = "Right (D)", getOffset = function(cf, dist) return cf.RightVector * dist end },
}

local function sendKeyState(keyCode, isDown)
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendKeyEvent(isDown, keyCode, false, game)
		end)
	end
end

local function moveStep(dirData)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		return
	end

	-- Reset Roblox's internal input timer alongside movement
	if antiAfkEnabled then
		pulseAntiAfk()
	end

	local startPos = rootPart.Position
	local targetPosition = startPos + dirData.getOffset(rootPart.CFrame, walkDistance)
	local speed = math.max(humanoid.WalkSpeed, 1)
	local maxStepTime = math.clamp((walkDistance / speed) + 0.15, 0.15, 2.0)

	-- Brief key tap registers hardware input for Anti-AFK without cancelling MoveTo
	sendKeyState(dirData.keyCode, true)
	task.wait(0.03)
	sendKeyState(dirData.keyCode, false)

	humanoid:MoveTo(targetPosition)

	local reached = false
	local conn
	conn = humanoid.MoveToFinished:Connect(function()
		reached = true
	end)

	local startWait = os.clock()
	while isRunning and not Library.Unloaded and not reached and (os.clock() - startWait) < maxStepTime do
		if (rootPart.Position - startPos).Magnitude >= walkDistance then
			break
		end
		task.wait(0.03)
	end

	if conn then
		conn:Disconnect()
	end
end

--// Main Loop \\--
task.spawn(function()
	while not Library.Unloaded do
		if isRunning then
			for _, dir in ipairs(directions) do
				if not isRunning or Library.Unloaded then
					break
				end
				StatusLabel:SetText("Status: Moving " .. dir.label)
				highlightKey(dir.key)
				moveStep(dir)
				task.wait(0.15)
			end
			highlightKey(nil)

			if isRunning and not Library.Unloaded and pauseDuration > 0 then
				StatusLabel:SetText(string.format("Status: Waiting (%.1fs)", pauseDuration))
				local waitStart = os.clock()
				while isRunning and not Library.Unloaded and (os.clock() - waitStart) < pauseDuration do
					task.wait(0.1)
				end
			end
		else
			highlightKey(nil)
			task.wait(0.2)
		end
	end
end)

--// UI Event Bindings \\--
Toggles.AutoWASD:OnChanged(function(Value)
	isRunning = Value
	Window:SetBadge(Value and "Running" or "Idle")
	StatusLabel:SetText(Value and "Status: Starting..." or "Status: Idle")
	if not Value then
		highlightKey(nil)
	end
end)

Toggles.AntiAFK:OnChanged(function(Value)
	antiAfkEnabled = Value
	setInternalIdledConnections(not Value)
end)

Options.WalkDistance:OnChanged(function(Value)
	walkDistance = Value
end)

Options.PauseDuration:OnChanged(function(Value)
	pauseDuration = Value
end)

Library:OnUnload(function()
	isRunning = false
	antiAfkEnabled = false
	if idledConnection then
		idledConnection:Disconnect()
	end
	setInternalIdledConnections(true)
	for _, dir in ipairs(directions) do
		sendKeyState(dir.keyCode, false)
	end
	highlightKey(nil)
end)
