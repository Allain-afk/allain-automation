--============================================================================--
--// Read-Only Player Progress Collector & Number Formatter
--============================================================================--

local suffixes = {
	{ "Dc", 1e33 },
	{ "No", 1e30 },
	{ "Oc", 1e27 },
	{ "Sp", 1e24 },
	{ "Sx", 1e21 },
	{ "Qi", 1e18 },
	{ "Qa", 1e15 },
	{ "T", 1e12 },
	{ "B", 1e9 },
	{ "M", 1e6 },
	{ "K", 1e3 },
}

local suffixMultipliers = {}
for _, pair in ipairs(suffixes) do
	suffixMultipliers[pair[1]:lower()] = pair[2]
end

local function formatAbbreviatedNumber(num)
	if typeof(num) ~= "number" or num ~= num then
		return "0"
	end
	local absNum = math.abs(num)
	for _, pair in ipairs(suffixes) do
		if absNum >= pair[2] then
			return string.format("%.1f%s", num / pair[2], pair[1]):gsub("%.0([A-Za-z])", "%1")
		end
	end
	return tostring(math.floor(num + 0.5))
end

local function parseAbbreviatedNumber(str)
	if typeof(str) == "number" then
		return str
	end
	if typeof(str) ~= "string" then
		return nil
	end
	local cleaned = str:gsub(",", ""):gsub("%$", ""):gsub("%s+", "")
	local numPart, suffixPart = cleaned:match("^([%+%-]?%d+%.?%d*)([A-Za-z]*)$")
	if not numPart then
		numPart, suffixPart = cleaned:match("([%+%-]?%d+%.?%d*)([A-Za-z]+)")
	end
	local val = tonumber(numPart)
	if not val then
		return nil
	end
	if suffixPart and suffixPart ~= "" then
		local mult = suffixMultipliers[suffixPart:lower()]
		if mult then
			val = val * mult
		end
	end
	return val
end

local function formatDuration(seconds)
	local total = math.max(0, math.floor(seconds))
	local hrs = math.floor(total / 3600)
	local mins = math.floor((total % 3600) / 60)
	local secs = total % 60
	return string.format("%02dh %02dm %02ds", hrs, mins, secs)
end

local function formatShortDuration(seconds)
	local total = math.max(0, math.floor(seconds))
	local hrs = math.floor(total / 3600)
	local mins = math.floor((total % 3600) / 60)
	local secs = total % 60
	if hrs > 0 then
		return string.format("%dh %dm", hrs, mins)
	end
	return string.format("%dm %ds", mins, secs)
end

local function scanPlayerGuiForPetsAndCandy()
	local petsText = nil
	local candyText = nil

	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return petsText, candyText
	end

	-- Scan ALL ScreenGuis in PlayerGui (not just MainGUI!)
	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") then
			local rawText = desc.Text or ""
			local okContent, contentText = pcall(function()
				return desc.ContentText
			end)
			if okContent and typeof(contentText) == "string" and contentText ~= "" then
				rawText = contentText
			end

			local text = rawText:gsub("<[^>]+>", ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
			local pathLower = desc:GetFullName():lower()

			if text ~= "" and #text < 80 then
				-- Match "Pets: 52/250" anywhere, or "52/250" inside any Pet/Inventory/Bag UI
				if not petsText then
					local cur, max = text:match("[Pp]ets:?%s*(%d+)%s*/%s*(%d+)")
					if not cur and (pathLower:find("pet") or pathLower:find("inv") or pathLower:find("bag") or pathLower:find("storage") or pathLower:find("list") or pathLower:find("header") or pathLower:find("count") or pathLower:find("capacity")) then
						cur, max = text:match("(%d+)%s*/%s*(%d+)")
					end
					if cur and max and tonumber(max) and tonumber(max) >= 20 then
						petsText = string.format("%s/%s in inventory", cur, max)
					end
				end

				-- Match Candy if present in GUI
				if not candyText and (pathLower:find("candy") or pathLower:find("candies")) then
					local val = text:match("(%d+%.?%d*[A-Za-z]*)")
					if val then
						candyText = val
					end
				end
			end
		end
	end

	return petsText, candyText
end

-- Track exact Cash attribute history for 100% accurate session/interval gains
local lastReportCashNumber = nil
local lastReportTimestamp = os.clock()

local function collectProgressSnapshot(isReportReset)
	local now = os.clock()
	local petsGuiText, candyGuiText = scanPlayerGuiForPetsAndCandy()

	-- 1. Exact Cash from Player Attribute: player:GetAttribute("Cash")
	local rawCash = player:GetAttribute("Cash")
	local currentCashNum = typeof(rawCash) == "number" and rawCash or parseAbbreviatedNumber(rawCash)
	local formattedCash = currentCashNum and ("$" .. formatAbbreviatedNumber(currentCashNum)) or "N/A"

	-- 2. Exact Cash/s Rate from Player Attribute: player:GetAttribute("CashPerSecond")
	local rawCashPerSec = player:GetAttribute("CashPerSecond")
	local cashPerSecNum = typeof(rawCashPerSec) == "number" and rawCashPerSec or parseAbbreviatedNumber(rawCashPerSec)
	local rateStr = cashPerSecNum and ("+" .. formatAbbreviatedNumber(cashPerSecNum) .. "/s") or nil

	if currentCashNum and not lastReportCashNumber then
		lastReportCashNumber = currentCashNum
		lastReportTimestamp = now
	end

	local cashFieldLines = {
		rateStr and string.format("%s (%s)", formattedCash, rateStr) or formattedCash,
	}

	if currentCashNum and lastReportCashNumber then
		local gained = math.max(0, currentCashNum - lastReportCashNumber)
		local elapsed = math.max(1, now - lastReportTimestamp)
		table.insert(cashFieldLines, string.format("+$%s in %s", formatAbbreviatedNumber(gained), formatShortDuration(elapsed)))
		if isReportReset then
			lastReportCashNumber = currentCashNum
			lastReportTimestamp = now
		end
	end

	-- 3. Exact Speed from Player Attribute: player:GetAttribute("SpeedPower")
	local rawSpeed = player:GetAttribute("SpeedPower")
	local speedNum = typeof(rawSpeed) == "number" and rawSpeed or parseAbbreviatedNumber(rawSpeed)
	local speedStr = speedNum and formatAbbreviatedNumber(speedNum) or "N/A"

	-- 4. Pets Inventory Counter ("52/250 in inventory")
	local petsStr = petsGuiText or "N/A"

	-- 5. Candy
	local rawCandy = player:GetAttribute("Candy") or player:GetAttribute("Candies")
	local candyStr = nil
	if rawCandy ~= nil then
		candyStr = typeof(rawCandy) == "number" and formatAbbreviatedNumber(rawCandy) or tostring(rawCandy)
	else
		candyStr = candyGuiText or "0"
	end

	-- 6. Doing
	local doingStr = isRunning
		and string.format("WASD Auto-Mover (%d studs, %.1fs pause)%s", walkDistance, pauseDuration, lockAnchorEnabled and " [Spot Locked]" or "")
		or "Idle (Auto-Mover Paused)"

	return {
		cash = table.concat(cashFieldLines, "\n"),
		speed = speedStr,
		pets = petsStr,
		session = string.format("%d WASD cycles", completedCycles),
		candy = candyStr,
		doing = doingStr,
	}
end

