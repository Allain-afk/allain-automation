local function autoSaveActiveConfig()
	if isInitializingConfig or not autoSaveEnabled then
		return
	end
	local targetConfig = SaveManager.AutoloadConfig
	if not targetConfig or targetConfig == "none" or targetConfig == "" then
		targetConfig = "default"
	end
	local saved = SaveManager:Save(targetConfig)
	if saved and (not SaveManager.AutoloadConfig or SaveManager.AutoloadConfig == "none") then
		SaveManager:SaveAutoloadConfig(targetConfig)
	end
end

--// Anti-AFK (Prevents Roblox 20-Minute Idle Kick / Error 278) \\--
local function pulseAntiAfk()
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
end

local function setInternalIdledConnections(enabled)
	local getconns = getconnections or get_signal_cons
	if getconns then
		pcall(function()
			for _, conn in pairs(getconns(player.Idled)) do
				if enabled then
					if conn.Enable then
						conn:Enable()
					end
				else
					if conn.Disable then
						conn:Disable()
					elseif conn.Disconnect then
						conn:Disconnect()
					end
				end
			end
		end)
	end
end

setInternalIdledConnections(false)

local idledConnection = player.Idled:Connect(function()
	if antiAfkEnabled and not Library.Unloaded then
		pulseAntiAfk()
	end
end)

--// Auto-Reconnect & Auto-Execute (queue_on_teleport) \\--
local function getQueueOnTeleport()
	return queue_on_teleport
		or (syn and syn.queue_on_teleport)
		or (fluxus and fluxus.queue_on_teleport)
		or queueonteleport
end

local function queueScriptForTeleport()
	if hasQueuedTeleport or not autoReconnectEnabled or Library.Unloaded then
		return
	end
	local queueFunc = getQueueOnTeleport()
	if queueFunc then
		local ok = pcall(function()
			queueFunc(string.format([[
if not game:IsLoaded() then
	game.Loaded:Wait()
end
loadstring(game:HttpGet(%q))()
]], scriptUrl))
		end)
		if ok then
			hasQueuedTeleport = true
		end
	end
end

local teleportConnection = player.OnTeleport:Connect(function()
	if autoReconnectEnabled and not Library.Unloaded then
		queueScriptForTeleport()
	end
end)

local function triggerReconnect(reason)
	if isReconnecting or not autoReconnectEnabled or Library.Unloaded then
		return
	end
	isReconnecting = true
	StatusLabel:SetText("Status: Disconnected — Reconnecting...")
	Window:SetBadge("Reconnecting")

	queueScriptForTeleport()

	task.spawn(function()
		local attempt = 0
		while autoReconnectEnabled and not Library.Unloaded do
			attempt += 1
			task.wait(attempt == 1 and 2 or 5)
			if Library.Unloaded or not autoReconnectEnabled then
				break
			end

			queueScriptForTeleport()

			if attempt <= 2 and game.JobId and game.JobId ~= "" then
				pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				end)
			else
				pcall(function()
					TeleportService:Teleport(game.PlaceId, player)
				end)
			end
		end
		isReconnecting = false
	end)
end

local errorChangedConnection = GuiService.ErrorMessageChanged:Connect(function(errorMessage)
	if errorMessage and errorMessage ~= "" then
		triggerReconnect(errorMessage)
	end
end)

local promptOverlayConnection
task.spawn(function()
	local ok, promptOverlay = pcall(function()
		return CoreGui:WaitForChild("RobloxGui", 10):WaitForChild("promptOverlay", 10)
	end)
	if ok and promptOverlay then
		if promptOverlay:FindFirstChild("ErrorPrompt") then
			triggerReconnect("ErrorPrompt")
		end
		promptOverlayConnection = promptOverlay.ChildAdded:Connect(function(child)
			if child.Name == "ErrorPrompt" then
				triggerReconnect("ErrorPrompt")
			end
		end)
	end
end)

--// WASD Movement Automation \\--
local directions = {
	{ key = "W", keyCode = Enum.KeyCode.W, label = "Forward (W)", getOffset = function(cf, dist) return cf.LookVector * dist end },
	{ key = "A", keyCode = Enum.KeyCode.A, label = "Left (A)", getOffset = function(cf, dist) return -cf.RightVector * dist end },
	{ key = "S", keyCode = Enum.KeyCode.S, label = "Backward (S)", getOffset = function(cf, dist) return -cf.LookVector * dist end },
	{ key = "D", keyCode = Enum.KeyCode.D, label = "Right (D)", getOffset = function(cf, dist) return cf.RightVector * dist end },
}

local function sendKeyState(keyCode, isDown)
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendKeyEvent(isDown, keyCode, false, game)
		end)
	end
end

local function moveStep(dirData)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		return
	end

	-- Reset Roblox's internal input timer alongside movement
	if antiAfkEnabled then
		pulseAntiAfk()
	end

	local startPos = rootPart.Position
	local targetPosition = startPos + dirData.getOffset(rootPart.CFrame, walkDistance)
	local speed = math.max(humanoid.WalkSpeed, 1)
	local maxStepTime = math.clamp((walkDistance / speed) + 0.15, 0.15, 2.0)

	-- Brief key tap registers hardware input for Anti-AFK without cancelling MoveTo
	sendKeyState(dirData.keyCode, true)
	task.wait(0.03)
	sendKeyState(dirData.keyCode, false)

	humanoid:MoveTo(targetPosition)

	local reached = false
	local conn
	conn = humanoid.MoveToFinished:Connect(function()
		reached = true
	end)

	local startWait = os.clock()
	while isRunning and not Library.Unloaded and not reached and (os.clock() - startWait) < maxStepTime do
		if (rootPart.Position - startPos).Magnitude >= walkDistance then
			break
		end
		task.wait(0.03)
	end

	if conn then
		conn:Disconnect()
	end
end

--// Main Loop \\--
task.spawn(function()
	while not Library.Unloaded do
		if isRunning then
			for _, dir in ipairs(directions) do
				if not isRunning or Library.Unloaded then
					break
				end
				StatusLabel:SetText("Status: Moving " .. dir.label)
				highlightKey(dir.key)
				moveStep(dir)
				task.wait(0.15)
			end
			highlightKey(nil)

			if isRunning and not Library.Unloaded and pauseDuration > 0 then
				StatusLabel:SetText(string.format("Status: Waiting (%.1fs)", pauseDuration))
				local waitStart = os.clock()
				while isRunning and not Library.Unloaded and (os.clock() - waitStart) < pauseDuration do
					task.wait(0.1)
				end
			end
		else
			highlightKey(nil)
			task.wait(0.2)
		end
	end
end)

--// UI Event Bindings \\--
Toggles.AutoWASD:OnChanged(function(Value)
	isRunning = Value
	Window:SetBadge(Value and "Running" or "Idle")
	StatusLabel:SetText(Value and "Status: Starting..." or "Status: Idle")
	if not Value then
		highlightKey(nil)
	end
	autoSaveActiveConfig()
end)

Toggles.AntiAFK:OnChanged(function(Value)
	antiAfkEnabled = Value
	setInternalIdledConnections(not Value)
	autoSaveActiveConfig()
end)

Toggles.AutoReconnect:OnChanged(function(Value)
	autoReconnectEnabled = Value
	if Value then
		queueScriptForTeleport()
	end
	autoSaveActiveConfig()
end)

Toggles.AutoSaveChanges:OnChanged(function(Value)
	autoSaveEnabled = Value
end)

Options.WalkDistance:OnChanged(function(Value)
	walkDistance = Value
	autoSaveActiveConfig()
end)

Options.PauseDuration:OnChanged(function(Value)
	pauseDuration = Value
	autoSaveActiveConfig()
end)

Options.AutoWASDKey:OnChanged(function()
	autoSaveActiveConfig()
end)

--// Load Autoload Config on Startup \\--
SaveManager:LoadAutoloadConfig()
if autoReconnectEnabled then
	queueScriptForTeleport()
end
task.delay(0.5, function()
	isInitializingConfig = false
end)

Library:OnUnload(function()
	isRunning = false
	antiAfkEnabled = false
	autoReconnectEnabled = false
	if idledConnection then
		idledConnection:Disconnect()
	end
	if teleportConnection then
		teleportConnection:Disconnect()
	end
	if errorChangedConnection then
		errorChangedConnection:Disconnect()
	end
	if promptOverlayConnection then
		promptOverlayConnection:Disconnect()
	end
	setInternalIdledConnections(true)
	for _, dir in ipairs(directions) do
		sendKeyState(dir.keyCode, false)
	end
	highlightKey(nil)
end)
