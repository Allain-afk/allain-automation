--============================================================================--
--// WASD Movement Automation + Anchor Anti-Drift
--============================================================================--

local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function highlightKey(activeKey)
	for k, data in pairs(keyBoxes) do
		local isCurrent = (k == activeKey)
		TweenService:Create(data.Label, tweenInfo, {
			BackgroundColor3 = isCurrent and activeBgColor or idleBgColor,
			TextColor3 = isCurrent and activeTextColor or idleTextColor,
		}):Play()
		TweenService:Create(data.Stroke, tweenInfo, {
			Color = isCurrent and activeBgColor or idleStrokeColor,
		}):Play()
	end
end

local directions = {
	{ key = "W", keyCode = Enum.KeyCode.W, label = "Forward (W)", getOffset = function(cf, dist) return cf.LookVector * dist end },
	{ key = "A", keyCode = Enum.KeyCode.A, label = "Left (A)", getOffset = function(cf, dist) return -cf.RightVector * dist end },
	{ key = "S", keyCode = Enum.KeyCode.S, label = "Backward (S)", getOffset = function(cf, dist) return -cf.LookVector * dist end },
	{ key = "D", keyCode = Enum.KeyCode.D, label = "Right (D)", getOffset = function(cf, dist) return cf.RightVector * dist end },
}

local function sendKeyState(keyCode, isDown)
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendKeyEvent(isDown, keyCode, false, game)
		end)
	end
end

local function walkToPoint(humanoid, rootPart, targetPosition, maxDistance)
	local startPos = rootPart.Position
	local speed = math.max(humanoid.WalkSpeed, 1)
	local maxStepTime = math.clamp((maxDistance / speed) + 0.15, 0.15, 2.5)

	humanoid:MoveTo(targetPosition)

	local reached = false
	local conn
	conn = humanoid.MoveToFinished:Connect(function()
		reached = true
	end)

	local startWait = os.clock()
	while isRunning and not Library.Unloaded and not reached and (os.clock() - startWait) < maxStepTime do
		if (rootPart.Position - startPos).Magnitude >= maxDistance then
			break
		end
		task.wait(0.03)
	end

	if conn then
		conn:Disconnect()
	end
end

local function moveStep(dirData)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		return
	end

	if not anchorPosition then
		anchorPosition = rootPart.Position
	end

	if antiAfkEnabled then
		pulseAntiAfk()
	end

	-- Brief key tap registers hardware input for Anti-AFK without cancelling MoveTo
	sendKeyState(dirData.keyCode, true)
	task.wait(0.03)
	sendKeyState(dirData.keyCode, false)

	local targetPosition = rootPart.Position + dirData.getOffset(rootPart.CFrame, walkDistance)
	walkToPoint(humanoid, rootPart, targetPosition, walkDistance)
end

local function returnToAnchor()
	if not lockAnchorEnabled or not anchorPosition then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then
		return
	end

	local flatDelta = Vector3.new(
		anchorPosition.X - rootPart.Position.X,
		0,
		anchorPosition.Z - rootPart.Position.Z
	)
	local driftDist = flatDelta.Magnitude
	if driftDist > 1.2 then
		StatusLabel:SetText("Status: Correcting drift...")
		walkToPoint(humanoid, rootPart, anchorPosition, driftDist + 0.5)
	end
end

--// Main WASD Loop \\--
task.spawn(function()
	while not Library.Unloaded do
		if isRunning then
			for _, dir in ipairs(directions) do
				if not isRunning or Library.Unloaded then
					break
				end
				StatusLabel:SetText("Status: Moving " .. dir.label)
				highlightKey(dir.key)
				moveStep(dir)
				task.wait(0.15)
			end
			highlightKey(nil)

			if isRunning and not Library.Unloaded then
				returnToAnchor()
				completedCycles += 1
				CyclesLabel:SetText("Cycles Completed: " .. tostring(completedCycles))
			end

			if isRunning and not Library.Unloaded and pauseDuration > 0 then
				StatusLabel:SetText(string.format("Status: Waiting (%.1fs)", pauseDuration))
				local waitStart = os.clock()
				while isRunning and not Library.Unloaded and (os.clock() - waitStart) < pauseDuration do
					task.wait(0.1)
				end
			end
		else
			highlightKey(nil)
			task.wait(0.2)
		end
	end
end)

--// Live Session Dashboard & Heartbeat Loop \\--
local renderSteppedConn = RunService.RenderStepped:Connect(function(dt)
	if dt > 0 then
		currentFps = math.clamp(math.floor(1 / dt + 0.5), 1, 999)
	end
end)

task.spawn(function()
	local lastHeartbeat = os.clock()
	local lastStatSample = 0
	while not Library.Unloaded do
		local now = os.clock()
		UptimeLabel:SetText("Uptime: " .. formatDuration(now - sessionStartTime))

		local pingMs = 0
		pcall(function()
			pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		PerfLabel:SetText(string.format("Performance: %d FPS | %d ms", currentFps, pingMs))

		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart and anchorPosition then
			local drift = Vector3.new(
				rootPart.Position.X - anchorPosition.X,
				0,
				rootPart.Position.Z - anchorPosition.Z
			).Magnitude
			DriftLabel:SetText(string.format("Anchor Drift: %.1f studs", drift))
		else
			DriftLabel:SetText("Anchor Drift: 0.0 studs")
		end

		-- Sample cash every 5s to keep the per-second rate and session gain accurate
		if (now - lastStatSample) >= 5 then
			lastStatSample = now
			pcall(collectProgressSnapshot, false)
		end

		if webhookHeartbeatEnabled and (now - lastHeartbeat) >= (webhookIntervalMin * 60) then
			lastHeartbeat = now
			task.spawn(function()
				sendProgressWebhook(nil, 0x5865F2, true)
			end)
		end

		task.wait(1)
	end
end)

